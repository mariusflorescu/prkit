{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ]
  },
  "include": ["*.ts", "fake-github/*.ts", "desktop-artifact/*.ts"]
}
