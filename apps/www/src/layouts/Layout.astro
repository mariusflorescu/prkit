---
import { Font } from "astro:assets";

import ogImage from "../../../../assets/brand/social/og-image.png";
import tokens from "../../../../assets/brand/tokens/tokens.json";
import { DESCRIPTION, TAGLINE } from "../site.ts";
import "../styles/global.css";

interface Props {
  /** The tab title; the home page's by default. */
  title?: string;
  /** Keeps a page out of search results: the hidden figure previews. */
  noindex?: boolean;
}

const { title = `prkit: ${TAGLINE}`, noindex = false } = Astro.props;
// Unfurlers need absolute URLs; without a public origin yet, they stay relative.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImageAlt = `The prkit logo with the tagline: ${TAGLINE}`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DESCRIPTION} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={tokens.paper} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={tokens.ink} media="(prefers-color-scheme: dark)" />
    {Astro.site && <link rel="canonical" href={absolute("/")} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="prkit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={absolute(ogImage.src)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {Astro.site && <meta property="og:url" content={absolute("/")} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={absolute(ogImage.src)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 500 }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: 400 }]} />

    <script is:inline>
      // The hero intro plays once per session. sessionStorage throws when storage is blocked;
      // the intro then simply plays.
      try {
        if (sessionStorage.getItem("prkit-intro")) document.documentElement.dataset.intro = "seen";
        else sessionStorage.setItem("prkit-intro", "1");
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: var(--gutter);
    /* Above the sticky header (10), which would otherwise cover it. */
    z-index: 20;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--heading);
    color: var(--background);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
