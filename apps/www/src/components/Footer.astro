---
import { GITHUB_URL, SECTIONS, TAGLINE } from "../site.ts";
import ArrowOut from "./ArrowOut.astro";
import BrandMark from "./BrandMark.astro";
---

<footer class="footer column">
  <div class="top">
    <div class="brand">
      <BrandMark class="symbol" />
      <p>{TAGLINE}</p>
      <p class="eyebrow">macOS first</p>
    </div>
    <nav aria-label="Footer">
      <div>
        <p class="eyebrow">On this page</p>
        <ul>
          {
            SECTIONS.map((section) => (
              <li>
                <a href={section.href}>{section.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">Project</p>
        <ul>
          <li>
            <a href={GITHUB_URL}>GitHub <ArrowOut /></a>
          </li>
          <li><a href="#download">Download</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="bottom">
    <p class="fine">
      prkit is not affiliated with GitHub, Anthropic or OpenAI. Claude and Codex are their makers'
      trademarks.
    </p>
    <a class="back" href="#main">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(4.5rem, 3rem + 5vw, 7rem);
    padding-bottom: max(2.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
  }

  .top {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
  }

  @media (min-width: 44rem) {
    .top {
      grid-template-columns: 1fr auto;
    }
  }

  .brand {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .brand :global(.symbol) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--heading);
  }

  nav {
    display: flex;
    gap: 3rem;
  }

  ul {
    display: grid;
    margin: 0.5rem 0 0 -0.5rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding-inline: 0.5rem;
    border-radius: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  a :global(svg) {
    width: 0.5625rem;
    height: 0.5625rem;
  }

  @media (pointer: coarse) {
    a {
      min-height: 2.75rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--heading);
    }
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .fine {
    max-width: 30rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .back {
    margin-inline: -0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
