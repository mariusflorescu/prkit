---
import { APPLE, GITHUB } from "../glyphs.ts";
import { repositoryOf } from "../release.ts";
import { GITHUB_URL } from "../site.ts";
import ArrowOut from "./ArrowOut.astro";
import Figure from "./Figure.astro";

// The release lookup (download.ts) runs only when GITHUB_URL names a repository.
const repository = repositoryOf(GITHUB_URL) ?? "";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="column">
    <p class="chip" data-rise>
      <span class="note">
        <span class="dot" aria-hidden="true"></span>
        <span class="swap">
          <span data-release-part="soon">Coming soon to macOS</span>
          <span data-release-part="ready"><span data-release-version></span> is out for macOS</span>
          <span data-release-part="sizer">00.00.00 is out for macOS</span>
        </span>
      </span>
      <a href={GITHUB_URL}>Follow on GitHub <ArrowOut /></a>
    </p>
    <h1 id="hero-title" data-rise style="--rise-step: 1">
      Your agents write the code. prkit keeps you in the loop.
    </h1>
    <p class="lead" data-rise style="--rise-step: 2">
      You can run twenty agents at once. You can't read twenty pull requests at once. prkit puts every
      one that needs you in one inbox, and your own Claude Code or Codex walks you through each
      change, core first, so you understand it before you approve it.
    </p>
    <div class="actions" data-rise style="--rise-step: 3">
      {
        /* Without an href this is a placeholder, not a control: a label shaped like the button it
           becomes when download.ts finds a stable release and gives it the disk image's URL. */
      }
      <a class="download" data-release-link="dmg" data-release-repo={repository}>
        <span class="icon" aria-hidden="true">
          <svg viewBox={APPLE.viewBox}><path fill="currentColor" d={APPLE.path} /></svg>
        </span>
        <span class="label">Download for macOS</span>
        <span class="badge">
          <span class="soon" data-release-part="soon">Coming soon</span>
          <span class="ready" data-release-part="ready">
            <span class="version">v<span data-release-version></span></span> · Apple Silicon
          </span>
          <span class="ready" data-release-part="sizer">v00.00.00 · Apple Silicon</span>
        </span>
      </a>
      <a class="github ticks" href={GITHUB_URL}>View on GitHub <ArrowOut /></a>
    </div>
    <div class="works" data-rise style="--rise-step: 4">
      <p class="eyebrow">Works with</p>
      <ul>
        <li>
          <svg viewBox={GITHUB.viewBox} aria-hidden="true"><path fill="currentColor" d={GITHUB.path} /></svg>
          GitHub
        </li>
        <li>Claude Code</li>
        <li>Codex</li>
      </ul>
    </div>
  </div>
  <div class="figure wide" data-rise style="--rise-step: 5">
    <Figure
      slug="pr-guide"
      placeholder={{
        title: "The guide",
        caption:
          "Your agent reads the pull request on your Mac and writes a guide: an overview, a before and after flow, then chapters that walk the diff one idea at a time, core change first.",
        ratio: [16, 9],
      }}
    />
  </div>
</section>

<script>
  import "../download.ts";
</script>

<style>
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .chip {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1;
  }

  .note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    color: var(--muted-foreground);
  }

  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
    transition: background-color 200ms var(--ease-out);
  }

  :global(:root[data-release="ready"]) .dot {
    background: var(--mark-accent);
  }

  .swap,
  .badge {
    display: grid;
  }

  .swap {
    font-variant-numeric: tabular-nums;
  }

  .chip a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0 0.75rem;
    margin: -1px -1px -1px 0;
    border: 1px solid var(--border);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--background);
    color: var(--heading);
    font-weight: 500;
    text-decoration: none;
  }

  @media (pointer: coarse) {
    .chip a {
      min-height: 2.75rem;
    }
  }

  .chip a :global(svg) {
    width: 0.625rem;
    height: 0.625rem;
    color: var(--muted-foreground);
  }

  h1 {
    margin-top: 1.75rem;
    font-size: clamp(2rem, 1.55rem + 1.8vw, 2.625rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.028em;
  }

  .lead {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .download,
  .github {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .download {
    gap: 0.75rem;
    padding: 0 0.375rem 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--foreground);
    text-decoration: none;
    cursor: default;
    transition: border-color 200ms var(--ease-out);
  }

  .download[href] {
    border-color: color-mix(in srgb, var(--heading) 40%, var(--border));
    color: var(--heading);
    cursor: pointer;
  }

  .icon {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 2.75rem;
    border-right: 1px solid var(--border);
  }

  .icon svg {
    width: 0.875rem;
    height: 1.0625rem;
    margin-top: -0.125rem;
    color: var(--heading);
  }

  .soon,
  .ready {
    padding: 0.4375rem 0.5rem;
    border-radius: 0.1875rem;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* Hatched, the way an unfinished part is drawn: it is real, it is not here yet. */
  .soon {
    border-radius: 0.1875rem;
    background: repeating-linear-gradient(
      -45deg,
      var(--surface) 0 3px,
      color-mix(in srgb, var(--surface) 40%, var(--border)) 3px 4px
    );
    color: var(--muted-foreground);
  }

  .ready {
    background: var(--heading);
    color: var(--background);
  }

  .version {
    text-transform: none;
  }

  .github {
    gap: 0.5rem;
    padding: 0 1.125rem;
    color: var(--primary);
    text-decoration: none;
  }

  .github :global(svg) {
    width: 0.6875rem;
    height: 0.6875rem;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .download[href]:hover {
      border-color: var(--heading);
    }

    .chip a:hover,
    .github:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }

    .github:hover :global(svg) {
      transform: translate(0.125rem, -0.125rem);
    }
  }

  .works {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
  }

  .works ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .works li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .works svg {
    width: 0.9375rem;
    height: 0.9375rem;
    color: var(--heading);
  }

  .figure {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .download,
    .github :global(svg) {
      transition: none;
    }
  }
</style>
