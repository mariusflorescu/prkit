---
import { GITHUB_URL } from "../site.ts";
import ArrowOut from "./ArrowOut.astro";
---

<section id="download" class="band" aria-labelledby="download-title">
  <div class="inner">
    <p class="eyebrow">macOS</p>
    <h2 id="download-title">Coming soon to your Mac.</h2>
    <p class="lead">
      prkit is still taking shape and there is no download yet. Follow along on GitHub to hear when
      the first release is out.
    </p>
    <a class="follow" href={GITHUB_URL}>Follow along on GitHub <ArrowOut /></a>
  </div>
</section>

<style>
  /* A quiet ink band in light, a raised surface in dark, with a faint isometric lattice: the
     grid the figures are drawn on. */
  .band {
    --band-bg: var(--prk-ink);
    --band-text: var(--prk-paper);
    --band-muted: color-mix(in srgb, var(--prk-paper) 66%, var(--prk-ink));
    --band-line: color-mix(in srgb, var(--prk-paper) 7%, transparent);
    position: relative;
    width: min(100% - 2 * var(--gutter) + 2rem, var(--column) + 4rem);
    margin: clamp(4.5rem, 3rem + 5vw, 7rem) auto 0;
    overflow: hidden;
    background-color: var(--band-bg);
    color: var(--band-text);
  }

  @media (prefers-color-scheme: dark) {
    .band {
      --band-bg: var(--surface);
      --band-text: var(--heading);
      --band-muted: var(--muted-foreground);
      --band-line: color-mix(in srgb, var(--prk-paper) 5%, transparent);
      box-shadow: inset 0 0 0 1px var(--border);
    }
  }

  .band::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      repeating-linear-gradient(30deg, var(--band-line) 0 1px, transparent 1px 1.5rem),
      repeating-linear-gradient(150deg, var(--band-line) 0 1px, transparent 1px 1.5rem);
    mask-image: linear-gradient(90deg, transparent 30%, black 100%);
  }

  .inner {
    position: relative;
    padding: clamp(2.25rem, 1.5rem + 3vw, 3.5rem) 2rem;
  }

  .eyebrow {
    color: var(--band-muted);
  }

  h2 {
    margin-top: 0.75rem;
    color: var(--band-text);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .lead {
    max-width: 30rem;
    margin-top: 0.75rem;
    color: var(--band-muted);
    line-height: 1.6;
  }

  .follow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 1.5rem;
    padding: 0 1rem;
    border: 1px solid color-mix(in srgb, var(--band-text) 24%, transparent);
    border-radius: var(--radius);
    color: var(--band-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .follow :global(svg) {
    width: 0.6875rem;
    height: 0.6875rem;
    transition: transform 200ms var(--ease-out);
  }

  .follow:focus-visible {
    outline-color: var(--band-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .follow:hover {
      border-color: var(--band-text);
    }

    .follow:hover :global(svg) {
      transform: translate(0.125rem, -0.125rem);
    }
  }

  @media (max-width: 30rem) {
    .inner {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .follow :global(svg) {
      transition: none;
    }
  }
</style>
