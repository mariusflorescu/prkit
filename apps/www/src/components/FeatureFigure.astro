---
import type { FigurePlaceholder } from "../figures/kit/prkit-frame.ts";
import Figure from "./Figure.astro";

/** A feature told in a few words, then shown in its figure. */
interface Props {
  eyebrow: string;
  title: string;
  slug: string;
  placeholder: FigurePlaceholder;
}

const { eyebrow, title, slug, placeholder } = Astro.props;
---

<div class="feature">
  <p class="eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="body"><slot /></p>
  <div class="figure">
    <Figure slug={slug} placeholder={placeholder} />
  </div>
</div>

<style>
  .feature {
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5rem);
  }

  h3 {
    margin-top: 0.625rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .body {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .figure {
    margin-top: 1.75rem;
  }
</style>
