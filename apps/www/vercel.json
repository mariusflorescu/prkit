{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile --prod --ignore-scripts --filter @prkit/www...",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../../assets/brand ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml"
}
